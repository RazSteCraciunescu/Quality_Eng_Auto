{
  "info": {
    "_postman_id": "4b4501b7-74a0-4e51-b370-2c810af1914f",
    "name": "Release Readiness Lab",
    "description": "REST and negative-path checks for the local release-readiness API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4173"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns 200', () => pm.response.to.have.status(200));",
              "pm.test('service is healthy', () => pm.expect(pm.response.json().status).to.eql('ok'));",
              "pm.test('request is traceable', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Blocked releases",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/releases?status=blocked",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "releases"
          ],
          "query": [
            {
              "key": "status",
              "value": "blocked"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.test('returns one blocked release', () => pm.expect(body.data).to.have.length(1));",
              "pm.test('Cirrus risk is stable', () => pm.expect(body.data[0].riskScore).to.eql(94.3));"
            ]
          }
        }
      ]
    },
    {
      "name": "Evaluate clean metrics",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"metrics\": {\n    \"passRate\": 99,\n    \"coverage\": 92,\n    \"flakyRate\": 1,\n    \"criticalDefects\": 0,\n    \"highDefects\": 0,\n    \"escapedDefects\": 0\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/releases/cirrus-231/evaluate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "releases",
            "cirrus-231",
            "evaluate"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns a ready result', () => pm.expect(pm.response.json().data.status).to.eql('ready'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown release",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/releases/unknown",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "releases",
            "unknown"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns 404', () => pm.response.to.have.status(404));",
              "pm.test('error code is stable', () => pm.expect(pm.response.json().error).to.eql('release_not_found'));"
            ]
          }
        }
      ]
    }
  ]
}
