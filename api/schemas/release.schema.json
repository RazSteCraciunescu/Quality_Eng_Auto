{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/release.schema.json",
  "title": "Evaluated release",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "version",
    "environment",
    "targetDate",
    "metrics",
    "riskScore",
    "status",
    "gateReasons"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "targetDate": {
      "type": "string",
      "format": "date"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "riskScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "conditional",
        "blocked"
      ]
    },
    "gateReasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passRate",
        "coverage",
        "flakyRate",
        "criticalDefects",
        "highDefects",
        "escapedDefects"
      ],
      "properties": {
        "passRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "flakyRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "criticalDefects": {
          "type": "integer",
          "minimum": 0
        },
        "highDefects": {
          "type": "integer",
          "minimum": 0
        },
        "escapedDefects": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
